# 本地调试/文档/工具/UI 调参页（不推送到 GitHub，保留本地）
# 例外：tools/bind-platform-live.* 是 CI 构建 platformlive.aar 的必需脚本（build.gradle.kts/release.yml 引用），保持入库。
# 本地私有版（设备 IP / 密钥路径）；公开版 LOCAL_DEV.md 入库
LOCAL_DEV.local.md
STABILITY_REPORT.md
devLog/
# 过程文档（代码审查、缺陷修复报告、改造台账、方案计划）只留本地，不入版本库；
# 仓库内文档只保留 README.md、CHANGELOG.md 与 platform_live_go/*.md。
docs/
.docs/
plan/
tools/*
!tools/bind-platform-live.sh
!tools/bind-platform-live.ps1
!tools/doctor.sh
!tools/doctor.ps1
!tools/verify_release_smoke.sh
!tools/verify_release_smoke.ps1
!tools/audit_all.py
!tools/watch.sh
!tools/gen_nsc.py
# 一起看长跑监控（签名服务自愈 + 随机多轮），需要随仓库复用，避免每次重写。
!tools/live_longrun_monitor.py
# T4-29 工具链 JSON 契约 / T7-44 schema 门禁：CI 需要随仓库复用。
!tools/_common.py
!tools/gen_oss_notices.py
!tools/check_action_pins.py
!tools/check_direct_log.py
!tools/check_no_secret_in_dex.py
!tools/pending_todo_lint.py
!tools/release_verify.py
# T-CI 诊断：Unit tests 失败时把失败断言打到 annotation，CI 需要随仓库复用。
!tools/diagnose_failed_tests.py
# goTimerAudit 门禁（挂 preBuild）：基线缺失会导致 CI 输入校验直接失败，必须入库。
!tools/go_timer_audit_baseline.txt
!tools/go_timer_audit.py
# T4-30 APK 体积预算：BuildConfigGovernanceTest 在 Linux CI 上读取此文件，
# tools/* 默认忽略导致 checkout 后缺失而测试失败，必须随仓库入库。
!tools/apk_budget.json
# T8-52 发版前 checklist：CI 的 Pre-release checklist 步骤引用，需要随仓库复用。
!tools/release_checklist.py
!tools/check_schema.sh
web/
*.stackdump

# 本地验收测试工具（Debug-only，不入 Release 包，不入库）
app/src/debug/

# Go 平台直播本地调试测试文件
platform_live_go/zz_debug_test.go
platform_live_go/flv_proxy_diag_test.go

