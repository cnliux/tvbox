<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置策略（由 tools/gen_nsc.py 生成，禁止手改）：
  直播源、订阅地址由用户自行导入，其中包含大量仅提供 http 的旧 IPTV/Plugin 地址，
  因此 base-config 必须保留明文通行。作为补偿，这里对应用内置的固定 API 域名强制 HTTPS。
  新增内置域请改 tools/gen_nsc.py 的 BUILTIN_DOMAINS 后重新生成，CI 会校验一致性（S1-02）。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 内置影视/搜索接口：强制 HTTPS（由 BUILTIN_DOMAINS 生成） -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">douban.com</domain>
        <domain includeSubdomains="true">doubanio.com</domain>
        <domain includeSubdomains="true">360kan.com</domain>
        <domain includeSubdomains="true">360.cn</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">jsdelivr.net</domain>
        <domain includeSubdomains="true">gh-proxy.com</domain>
        <domain includeSubdomains="true">gh-proxy.org</domain>
        <domain includeSubdomains="true">ghproxy.net</domain>
    </domain-config>

    <!-- 仅 Debug 信任用户 CA，Release 不信任，避免中间人风险 -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
